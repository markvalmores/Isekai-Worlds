{
  "entities": {
    "HistoryEntry": {
      "title": "History Entry",
      "description": "An entry for watch or browsing history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["watch", "browse"] },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "type", "url", "title", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}/watchHistory/{entryId}": {
      "schema": "HistoryEntry",
      "description": "Watch history for a user"
    },
    "/users/{userId}/browsingHistory/{entryId}": {
      "schema": "HistoryEntry",
      "description": "Browsing history for a user"
    }
  }
}
